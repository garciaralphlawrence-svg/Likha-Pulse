# ---- Core ----
ENVIRONMENT=development            # set to production on a server
DATABASE_URL=postgresql+psycopg://paph:paph@localhost:5432/paph_quotes
# DATABASE_URL=sqlite:///./paph_quotes.db   # quick local trial without PostgreSQL
JWT_SECRET=                        # REQUIRED: long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=120
CORS_ORIGINS=http://localhost:5173

# ---- First Owner account (role ADMIN), created on first start when no users exist ----
SUPERADMIN_EMAIL=owner@yourcompany.com
SUPERADMIN_PASSWORD=               # at least 10 characters with letters and numbers
SUPERADMIN_NAME=Owner

# ---- Behaviour ----
SEED_SAMPLE_DATA=true              # loads 10 clearly labeled sample travel requests when there are none
PUBLIC_RATE_LIMIT=20               # public request form: max requests per IP per minute

# ---- Facebook Page comments + Messenger (official Meta Graph API) ----
# Leave empty = "Not connected". Needs a Meta app that passed App Review for pages_read_engagement,
# pages_read_user_content and pages_messaging, and a long-lived Page access token for PAPH's Page.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# ---- Email for the Monday weekly report (8 AM Philippine time). Empty = the report is only logged ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ---- Privacy ----
ANONYMIZE_AUTHORS=true             # real Facebook/Messenger names are shown as "Client 7F3A"; false = keep names
AUTHOR_HASH_SALT=                  # random string
ENABLE_SCHEDULER=true              # weekly report + 30-minute Facebook/Messenger sync
