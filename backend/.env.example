# ---- Core ----
ENVIRONMENT=development            # set to production on a server
DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/likha_pulse
# DATABASE_URL=sqlite:///./likha_pulse.db   # quick local trial without PostgreSQL
JWT_SECRET=                        # REQUIRED: long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=120
CORS_ORIGINS=http://localhost:5173

# ---- First Super Admin (created on first start when no users exist) ----
SUPERADMIN_EMAIL=admin@yourcompany.com
SUPERADMIN_PASSWORD=               # at least 10 characters with letters and numbers
SUPERADMIN_NAME=Super Admin

# ---- Optional: Claude analysis engine (leave empty to use the free rule engine) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Optional: Google Business Profile (official API, OAuth token with business.manage) ----
GOOGLE_BUSINESS_ACCESS_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# ---- Optional: Facebook Page comments + Messenger (Meta Graph API, approved permissions) ----
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# ---- Optional: email notifications / password reset ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Privacy & behaviour ----
ANONYMIZE_AUTHORS=true
AUTHOR_HASH_SALT=                  # random string
REPORTS_DIR=./generated_reports
ENABLE_SCHEDULER=true
SEED_SAMPLE_DATA=true              # loads clearly labeled sample data when the database is empty
