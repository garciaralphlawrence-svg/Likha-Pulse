# ---- Core ----
ENVIRONMENT=development            # set to production on a server
DATABASE_URL=postgresql+psycopg://paph:paph@localhost:5432/paph_quotes
# DATABASE_URL=sqlite:///./paph_quotes.db   # quick local trial without PostgreSQL
JWT_SECRET=                        # REQUIRED: long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=120
CORS_ORIGINS=http://localhost:5173

# ---- First Owner account (role ADMIN), created on first start when no users exist ----
SUPERADMIN_EMAIL=owner@yourcompany.com
SUPERADMIN_PASSWORD=               # at least 10 characters with letters and numbers
SUPERADMIN_NAME=Owner

# ---- Behaviour ----
SEED_SAMPLE_DATA=true              # loads 10 clearly labeled sample travel requests when there are none
PUBLIC_RATE_LIMIT=20               # public request form: max requests per IP per minute
